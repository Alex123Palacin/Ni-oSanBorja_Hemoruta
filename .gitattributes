# Auto detect text files and perform LF normalization
* text=auto

# Docker entrypoints must remain executable in Linux containers.
*.sh text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Volcado SQL generado; las filas COPY pueden terminar en tabuladores válidos.
baseDatos.txt -diff
